# Production env — copy to deploy/.env.prod and fill in. NEVER commit the filled file.
# In production the app fails fast if the bunny keys / a real ADMIN_TOKEN are missing.

APP_ENV=production

# --- Percona / MySQL 8 (the EXISTING `percona_db` container on the csstrats_default network) ---
# We join that external network in compose.prod.yml, so the host is the CONTAINER NAME (not an IP
# or 127.0.0.1 — the DB's published port is host-loopback-only). demoviewer needs its OWN database +
# user (the csstrats user only has rights on the csstrats DB); create them once — see RELEASE.md §2a.
DB_HOST=percona_db
DB_PORT=3306
DB_USER=demoviewer
DB_PASSWORD=__set_me__
DB_NAME=demoviewer

# --- Redis (the EXISTING `redis_cache` container; demoviewer isolated on logical db 3) ---
# NOTE: that Redis runs allkeys-lru eviction. demoviewer's footprint is tiny, but arq's job queue
# also lives here — under sustained 12 GB pressure a queued job could be evicted. Fine for normal
# load; if you ingest huge batches, give demoviewer its own small Redis instead.
REDIS_URL=redis://redis_cache:6379/3

# --- bunny.net 'demos' storage zone (hot payloads + warm parquet) + its Pull Zone host ---
BUNNY_DEMOS_STORAGE_KEY=__write_access_key__
BUNNY_DEMOS_STORAGE_HOST=storage.bunnycdn.com
BUNNY_DEMOS_CDN_HOST=demos.b-cdn.net          # the demos Pull Zone hostname (read URLs)
BUNNY_DEMOS_ZONE=demos

# --- bunny.net COLD archive zone (compressed raw .dem; never served) ---
# The warm canonical.zip lives in the demos zone alongside payloads (cheap at $0.01/GB).
BUNNY_ARCHIVE_STORAGE_KEY=__write_access_key__
BUNNY_ARCHIVE_ZONE=demoviewer-cold

# --- Steam Web API (optional player summaries) ---
STEAM_API_KEY=
INGEST_STEAM_SUMMARIES=false

# --- Admin/owner bootstrap token — MUST be a real secret (not 'change-me') ---
ADMIN_TOKEN=__long_random_secret__

# --- Key auth / rate limiting ---
KEY_CACHE_TTL=30
KEY_ROTATION_GRACE_SECONDS=86400
CLIENT_DEFAULT_RATE_PER_HOUR=100
RATE_LIMIT_WINDOW_SECONDS=3600

# --- Versions / limits ---
API_VERSION=v1
PAYLOAD_VERSION=1
PAYLOAD_GZIP_LEVEL=6
MAX_DEMO_BYTES=524288000

# --- Ingestion tuning ---
INGEST_DOWNLOAD_TIMEOUT=120
INGEST_PARSE_TIMEOUT=1800
INGEST_ZIP_MAX_MEMBERS=64
INGEST_ROUND_UPLOAD_CONCURRENCY=15
INGEST_ARCHIVE_ZSTD_LEVEL=10
