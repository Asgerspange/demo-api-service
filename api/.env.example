# Copy to .env and fill in. Local defaults match deploy/compose.dev.yml.

# dev | production — production requires the bunny keys + a real ADMIN_TOKEN
APP_ENV=dev

# --- Database (local dev container) ---
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=demoviewer
DB_PASSWORD=devpass
DB_NAME=demoviewer

# --- Redis (server's shared Redis over an SSH tunnel; deploy/redis-tunnel.sh) ---
# db 3 isolates demoviewer from the Laravel apps on the same instance (they use db 0/1).
REDIS_URL=redis://127.0.0.1:6379/3

# --- bunny.net 'demos' storage zone (hot payloads + warm parquet) ---
BUNNY_DEMOS_STORAGE_KEY=
BUNNY_DEMOS_STORAGE_HOST=storage.bunnycdn.com
BUNNY_DEMOS_CDN_HOST=
BUNNY_DEMOS_ZONE=demos

# --- bunny.net cold archive (compressed raw .dem; the canonical.zip lives in the demos zone) ---
BUNNY_ARCHIVE_STORAGE_KEY=
BUNNY_ARCHIVE_ZONE=

# --- Steam Web API (optional player summaries) ---
STEAM_API_KEY=

# --- Admin/owner bootstrap token (creates the first users) ---
ADMIN_TOKEN=change-me

# --- Key auth (Stage 03) ---
KEY_CACHE_TTL=30
KEY_ROTATION_GRACE_SECONDS=86400
CLIENT_DEFAULT_RATE_PER_HOUR=100

# --- Rate limiting (Stage 04) ---
RATE_LIMIT_WINDOW_SECONDS=3600

# --- Content access control & anti-abuse (Stage 13) ---
BUNNY_DEMOS_TOKEN_KEY=          # pull-zone Token Authentication key → signed payload URLs (empty = serve via API)
CDN_TOKEN_TTL=3600             # signed payload-URL lifetime (seconds)
BANDWIDTH_CAP_BYTES=0          # per-tenant payload bytes per window; 0 = unlimited
BANDWIDTH_WINDOW_SECONDS=86400 # bandwidth accounting window (daily)

# --- Versions / limits ---
API_VERSION=v1
PAYLOAD_VERSION=1
PAYLOAD_GZIP_LEVEL=6              # per-round payload compression (1=fast..9=smallest)
MAX_DEMO_BYTES=524288000

# --- Ingestion (Stage 05) ---
INGEST_DOWNLOAD_TIMEOUT=120          # hard cap on a URL download (seconds)
INGEST_PARSE_TIMEOUT=1800            # hard cap on a single parse (seconds)
INGEST_ZIP_MAX_MEMBERS=64            # zip-bomb guard: reject archives with more members
INGEST_ROUND_UPLOAD_CONCURRENCY=15   # bounded parallel per-round payload uploads
INGEST_ARCHIVE_ZSTD_LEVEL=10         # cold-archive zstd level (multithreaded; demos are high-entropy)
INGEST_STEAM_SUMMARIES=false         # opt-in Steam player summaries (needs STEAM_API_KEY)
INGEST_RAR_SUPPORTED=true            # rar/7z multi-demo archives via libarchive/bsdtar (Stage 18); gated by its presence

# --- Multi-tenancy & fairness (Stage 16) ---
INGEST_TENANT_MAX_INFLIGHT=3         # max concurrent parses per tenant (0 = no cap)
INGEST_DEFER_SECONDS=5               # re-enqueue delay when a tenant is at its cap
INGEST_QUEUE_DEPTH_CEILING=0         # backpressure: shed new ingests above this depth (0 = off)
WORKER_QUEUE=                        # which priority lane THIS worker pool drains (empty = standard).
                                     #   enterprise pool: arq:queue:enterprise · free: arq:queue:free · backfill: arq:queue:backfill

# --- Debug single-demo ingest (Stage 05 path mode) ---
DEBUG_DEMO_PATH=./demo.dem
